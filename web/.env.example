# 이 파일에는 이름만 둔다. 값은 web/.env.local(Git 제외)에 넣는다.
# 두 값이 없으면 화면은 시연용 예시 데이터로 동작한다.

# Supabase 프로젝트 주소 (https://....supabase.co)
VITE_SUPABASE_URL=

# 공개용 키만 (anon 또는 sb_publishable_). 관리자 키(service_role, sb_secret_)는 넣지 않는다
VITE_SUPABASE_ANON_KEY=

# AI 내비게이터 외부 공고 찾기: live로 두면 Supabase Edge Function(ai-navigator)을 부른다.
# 비워 두면 '키 연결 전 · 예시 응답' 모드. AI 키는 여기에 넣지 않는다(Edge Function 비밀값으로만)
VITE_AI_NAVIGATOR=
